{
  "name": "@scottschreckengaust/app-framework-test-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottschreckengaust/framework-for-github-app-on-aws.git"
  },
  "scripts": {
    "build": "tsc && yarn test && yarn lint",
    "compile": "tsc",
    "test": "jest --passWithNoTests --updateSnapshot",
    "lint": "eslint .",
    "clean": "rm -rf lib/ coverage/ cdk.out/",
    "deploy": "cdk deploy",
    "synth": "cdk synth"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-cdk": "^2",
    "esbuild": "^0.25.1",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "jest-junit": "^16",
    "jest-runner-groups": "^2.2.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-node": "^3.806.0",
    "@aws-sdk/hash-node": "^3.374.0",
    "@scottschreckengaust/app-framework-for-github-apps-on-aws": "^0.0.0",
    "@scottschreckengaust/app-framework-for-github-apps-on-aws-client": "^0.0.1",
    "aws-cdk-lib": "^2.184.1",
    "constructs": "^10.4.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "runner": "groups",
    "verbose": true,
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  }
}

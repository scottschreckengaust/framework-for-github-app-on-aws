{
  "name": "@scottschreckengaust/app-framework-for-github-apps-on-aws-ops-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottschreckengaust/framework-for-github-app-on-aws.git"
  },
  "bin": {
    "app-framework-for-github-apps-on-aws-ops-tools": "lib/app-framework-cli.js"
  },
  "scripts": {
    "build": "tsc && yarn test && yarn lint",
    "compile": "tsc",
    "test": "jest --passWithNoTests --updateSnapshot --testPathIgnorePatterns='.*\\.accept\\.test\\.ts$'",
    "lint": "eslint .",
    "clean": "rm -rf lib/ coverage/",
    "cli": "ts-node ./src/app-framework-cli.ts"
  },
  "author": {
    "name": "Scott Schreckengaust",
    "email": "scottschreckengaust@users.noreply.github.com",
    "organization": false
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2",
    "@types/jest": "^29.5.14",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "jest-junit": "^16",
    "jest-runner-groups": "^2.2.0",
    "mock-fs": "^5.5.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.777.0",
    "@aws-sdk/client-kms": "^3.777.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.777.0",
    "commander": "^11.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "runner": "groups",
    "verbose": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".*\\.accept\\.test\\.ts$"
    ],
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      ".*\\.accept\\.test\\.ts$"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts"
}

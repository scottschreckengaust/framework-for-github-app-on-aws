{
  "name": "@scottschreckengaust/app-framework-for-github-apps-on-aws",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottschreckengaust/framework-for-github-app-on-aws.git"
  },
  "scripts": {
    "build": "npx lerna run build --concurrency=1 --sort",
    "test": "npx lerna run test",
    "lint": "npx lerna run lint",
    "clean": "npx lerna run clean",
    "cli": "ts-node src/packages/app-framework-ops-tools/src/app-framework-cli.ts"
  },
  "author": {
    "name": "Scott Schreckengaust",
    "email": "scottschreckengaust@users.noreply.github.com",
    "organization": false
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.6",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-cdk-lib": "2.189.1",
    "constructs": "10.4.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "jest-junit": "^16",
    "jest-runner-groups": "^2.2.0",
    "lerna": "^8.2.1",
    "prettier": "^3.5.2",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.189.1",
    "constructs": "^10.4.2"
  },
  "keywords": [
    "cdk"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "runner": "groups",
    "verbose": true,
    "modulePathIgnorePatterns": [
      "\\.claude/worktrees/"
    ],
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.dev.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "stability": "stable",
  "private": true,
  "workspaces": [
    "src/packages/*",
    "src/packages/smithy/build/smithy/source/*"
  ]
}
